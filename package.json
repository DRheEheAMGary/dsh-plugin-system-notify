{
  "name": "dsh-plugin-system-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let an agent send the user a native desktop notification (macOS Notification Center, Windows toast, Linux desktop alert) raised by the DeepSeek Harness itself.",
  "license": "MIT",
  "author": "DRheEheAMGary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DRheEheAMGary/dsh-plugin-system-notify.git"
  },
  "bugs": {
    "url": "https://github.com/DRheEheAMGary/dsh-plugin-system-notify/issues"
  },
  "homepage": "https://github.com/DRheEheAMGary/dsh-plugin-system-notify#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "system-notification"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  }
}
